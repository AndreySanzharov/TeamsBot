package org.example;

import com.fasterxml.jackson.databind.JsonNode;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import ru.mail.im.botapi.BotApiClient;
import ru.mail.im.botapi.BotApiClientController;
import ru.mail.im.botapi.api.entity.SendTextRequest;
import ru.mail.im.botapi.api.entity.InlineKeyboardButton;
import ru.mail.im.botapi.fetcher.event.CallbackQueryEvent;
import ru.mail.im.botapi.fetcher.event.Event;
import ru.mail.im.botapi.fetcher.event.NewMessageEvent;

import java.io.IOException;
import java.util.*;

public class MenuBot {
    private static final Logger log = LoggerFactory.getLogger(MenuBot.class);

    private static final String TOKEN = ""; // Укажите токен
    private static final BotApiClient client = new BotApiClient("", TOKEN, 0, 60);
    private static final BotApiClientController controller = BotApiClientController.startBot(client);

    private static final UserStateService userStateService = new UserStateService();
    private static final JsonService jsonService = new JsonService("src/main/java/org/example/JsonHandlers/questions.json");
    private static final SendService sendService = new SendService(client, controller);

    public static void main(String[] args) throws IOException {
        client.addOnEventFetchListener(events -> events.forEach(MenuBot::handleEvent));
        client.start();
    }

    public static void handleEvent(Event event) {
        String chatId;
        switch (event) {
            case NewMessageEvent newMessage -> {
                chatId = newMessage.getChat().getChatId();
                log.info("Получено новое сообщение от пользователя: {}", chatId);

                userStateService.resetUserState(chatId);
                JsonNode root = jsonService.loadJson();
                userStateService.setUserState(chatId, root);
                sendService.sendQuestionWithButtons(chatId, root);
            }
            case CallbackQueryEvent callback -> {
                chatId = callback.getFrom().getUserId();
                String data = callback.getCallbackData();
                log.info("Обработка callback от пользователя {}: {}", chatId, data);

                JsonNode currentNode = userStateService.getUserState(chatId);
                if (currentNode == null) {
                    log.warn("Пустое состояние у пользователя {}", chatId);
                    return;
                }

                JsonNode options = currentNode.get("options");
                if (options == null || !options.isArray()) {
                    log.warn("Некорректные опции в JSON у пользователя {}", chatId);
                    return;
                }

                for (JsonNode option : options) {
                    if (option.has("text") && data.equals(option.get("text").asText())) {
                        if (option.has("next")) {
                            JsonNode next = option.get("next");
                            userStateService.setUserState(chatId, next);
                            sendService.sendQuestionWithButtons(chatId, next);
                        } else if (option.has("message")) {
                            String message = option.get("message").asText();
                            sendService.sendText(chatId, message);
                            userStateService.resetUserState(chatId);
                        } else {
                            sendService.sendText(chatId, "Вы выбрали: " + data);
                            userStateService.resetUserState(chatId);
                        }
                        break;
                    }
                }
            }
            default -> log.warn("Необработанный тип события: {}", event.getClass().getSimpleName());
        }
    }
}

class UserStateService {
    private final Map<String, JsonNode> userStates = new HashMap<>();

    public void setUserState(String chatId, JsonNode node) {
        userStates.put(chatId, node);
    }

    public JsonNode getUserState(String chatId) {
        return userStates.get(chatId);
    }

    public void resetUserState(String chatId) {
        userStates.remove(chatId);
    }
}

class JsonService {
    private final String filePath;

    public JsonService(String filePath) {
        this.filePath = filePath;
    }

    public JsonNode loadJson() {
        try (var inputStream = new java.io.FileInputStream(filePath)) {
            return new com.fasterxml.jackson.databind.ObjectMapper().readTree(inputStream);
        } catch (IOException e) {
            throw new RuntimeException("Ошибка загрузки JSON файла", e);
        }
    }
}

class SendService {
    private final BotApiClient client;
    private final BotApiClientController controller;

    public SendService(BotApiClient client, BotApiClientController controller) {
        this.client = client;
        this.controller = controller;
    }

    public void sendQuestionWithButtons(String chatId, JsonNode node) {
        if (node == null || !node.has("description")) return;

        String question = node.get("description").asText();
        List<List<InlineKeyboardButton>> keyboard = new ArrayList<>();

        JsonNode options = node.get("options");
        if (options != null && options.isArray()) {
            for (JsonNode option : options) {
                if (option.has("text")) {
                    String text = option.get("text").asText();
                    keyboard.add(Collections.singletonList(
                        InlineKeyboardButton.callbackButton(text, text, "primary")
                    ));
                }
            }
        }

        try {
            client.messages().sendText(chatId, question, null, null, null, null, null, keyboard);
        } catch (IOException e) {
            throw new RuntimeException("Ошибка при отправке сообщения", e);
        }
    }

    public void sendText(String chatId, String message) {
        try {
            controller.sendTextMessage(new SendTextRequest().setChatId(chatId).setText(message));
        } catch (IOException e) {
            throw new RuntimeException("Ошибка при отправке текста", e);
        }
    }
}
