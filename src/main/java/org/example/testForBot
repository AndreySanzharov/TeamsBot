package org.example;

import org.json.JSONObject;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import ru.mail.im.botapi.fetcher.event.NewMessageEvent;

import java.util.Map;
import java.util.concurrent.*;

import static org.junit.jupiter.api.Assertions.*;

class QuestionnaireBotTest {
    private static final int THREAD_COUNT = 5; // Количество одновременно работающих пользователей

    @BeforeEach
    void setUp() {
        QuestionnaireBot.userStates.clear();
        QuestionnaireBot.userResponses.clear();
    }

    @Test
    void testConcurrentUsers() throws InterruptedException {
        ExecutorService executorService = Executors.newFixedThreadPool(THREAD_COUNT);
        CountDownLatch latch = new CountDownLatch(THREAD_COUNT);

        for (int i = 1; i <= THREAD_COUNT; i++) {
            final String chatId = "user" + i;
            executorService.submit(() -> {
                try {
                    simulateUserInteraction(chatId);
                } finally {
                    latch.countDown();
                }
            });
        }

        latch.await(); // Ждем завершения всех потоков
        executorService.shutdown();

        // Проверяем, что у всех пользователей есть сохраненные ответы
        for (int i = 1; i <= THREAD_COUNT; i++) {
            String chatId = "user" + i;
            assertTrue(QuestionnaireBot.userResponses.containsKey(chatId), "Ответы не сохранены для " + chatId);
            assertFalse(QuestionnaireBot.userResponses.get(chatId).isEmpty(), "Список ответов пуст у " + chatId);
        }
    }

    /**
     * Симуляция работы одного пользователя
     */
    private void simulateUserInteraction(String chatId) {
        // Начало опроса
        QuestionnaireBot.handleUserResponse(createMessageEvent(chatId, "start"));

        JSONObject firstQuestionNode = QuestionnaireBot.userStates.get(chatId);
        assertNotNull(firstQuestionNode, "Состояние не создано для " + chatId);

        String firstQuestion = firstQuestionNode.keys().next();
        JSONObject possibleAnswers = firstQuestionNode.getJSONObject(firstQuestion);

        // Отвечаем на первый вопрос (выбираем первый доступный ответ)
        String firstAnswer = possibleAnswers.keys().next();
        QuestionnaireBot.handleUserResponse(createMessageEvent(chatId, firstAnswer));

        // Проверяем, что ответ пользователя записался
        Map<String, String> responses = QuestionnaireBot.userResponses.get(chatId);
        assertNotNull(responses, "Ответы не записаны для " + chatId);
        assertEquals(firstAnswer, responses.get(firstQuestion), "Ответ пользователя не совпадает");
    }

    /**
     * Создает объект события входящего сообщения от пользователя
     */
    private NewMessageEvent createMessageEvent(String chatId, String text) {
        return new NewMessageEvent() {
            @Override
            public ru.mail.im.botapi.fetcher.entity.Chat getChat() {
                return () -> chatId;
            }

            @Override
            public String getText() {
                return text;
            }
        };
    }
}
